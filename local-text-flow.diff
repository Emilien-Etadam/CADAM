+interface ChatCompletionsRequest {
+  model: string;
+  messages: OpenAIMessage[];
+  tools?: unknown[];
+  stream?: boolean;
+  max_tokens?: number;
+  reasoning?: {
+    max_tokens?: number;
+    effort?: 'high' | 'medium' | 'low';
+  };
+}
