+              // — never swallow them in the parse-tolerance block above.
+              if (chunk.error) {
+                console.error('Chat completions stream error:', chunk.error);
+                throw new Error(
+                  chunk.error.message ||
+                    `Stream error: ${JSON.stringify(chunk.error)}`,
+                );
+              }
